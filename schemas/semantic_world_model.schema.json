{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic World Model",
  "type": "object",
  "required": ["schema_version", "map_frame", "places", "objects", "topology"],
  "properties": {
    "schema_version": {"type": "string"},
    "map_frame": {"$ref": "#/$defs/frame"},
    "floors": {"type": "array", "items": {"$ref": "#/$defs/floor"}},
    "places": {"type": "array", "items": {"$ref": "#/$defs/place"}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "topology": {"$ref": "#/$defs/topology"},
    "map_artifacts": {"$ref": "#/$defs/map_artifacts"}
  },
  "$defs": {
    "frame": {
      "type": "object",
      "required": ["name", "units", "axis_convention", "origin_definition"],
      "properties": {
        "name": {"type": "string", "const": "map"},
        "units": {"type": "string", "const": "m"},
        "axis_convention": {"type": "string", "const": "x_forward_or_building_east_y_left_or_building_north_z_up"},
        "origin_definition": {"type": "string"},
        "earth_alignment": {"type": "string"}
      }
    },
    "pose": {
      "type": "object",
      "required": ["position_xyz", "orientation_xyzw", "covariance_6x6"],
      "properties": {
        "position_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "covariance_6x6": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}}
      }
    },
    "floor": {
      "type": "object",
      "required": ["floor_id", "z_interval_m", "elevation_confidence"],
      "properties": {
        "floor_id": {"type": "string"},
        "z_interval_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "elevation_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "place": {
      "type": "object",
      "required": ["place_id", "place_type", "floor_id", "region", "confidence"],
      "properties": {
        "place_id": {"type": "string"},
        "place_type": {"type": "string", "enum": ["room", "corridor", "stair_landing", "elevator_lobby", "other"]},
        "label_candidates": {"type": "array", "items": {"type": "string"}},
        "floor_id": {"type": "string"},
        "region": {"$ref": "#/$defs/region"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "object": {
      "type": "object",
      "required": ["object_id", "class_candidates", "geometry", "state", "lifecycle_status", "confidence", "evidence"],
      "properties": {
        "object_id": {"type": "string"},
        "class_candidates": {"type": "array", "items": {"type": "object", "required": ["label", "probability"], "properties": {"label": {"type": "string"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "attributes": {"type": "object", "additionalProperties": true},
        "geometry": {"$ref": "#/$defs/geometry"},
        "state": {"type": "string", "enum": ["static", "movable", "dynamic", "unknown"]},
        "lifecycle_status": {"type": "string", "enum": ["tentative", "confirmed", "occluded", "moved", "removed", "unknown"]},
        "traversability": {"type": "string", "enum": ["free_surface", "obstacle", "unknown", "conditional"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "retention": {"type": "string", "enum": ["persistent", "persistent_compact", "ephemeral"]},
        "first_seen": {"type": "string"},
        "last_seen": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["anchor_xyz", "geometry_type", "geometry_quality"],
      "properties": {
        "anchor_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "aabb_min_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "aabb_max_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "oriented_box": {"type": "object", "required": ["center_xyz", "size_xyz", "orientation_xyzw"], "properties": {"center_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "size_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}}},
        "surface_corners": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
        "footprint": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "geometry_type": {"type": "string", "enum": ["anchor_only", "aabb", "oriented_box", "mesh_fragment", "plane_region", "unknown"]},
        "geometry_quality": {"type": "string", "enum": ["coarse", "refined", "unknown"]},
        "surface_relation": {"type": "string", "enum": ["vertical_to_traversable", "parallel_to_traversable", "not_applicable", "unknown"]},
        "normal_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "pose_covariance_6x6": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}}
      }
    },
    "region": {
      "type": "object",
      "required": ["polygon_xy", "z_interval_m"],
      "properties": {
        "polygon_xy": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "z_interval_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["source_type", "timestamp", "score"],
      "properties": {
        "source_type": {"type": "string", "enum": ["rgb", "depth", "imu", "visual_feature", "loop_closure", "human", "external_anchor"]},
        "timestamp": {"type": "string"},
        "keyframe_id": {"type": "string"},
        "image_crop_uri": {"type": "string"},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "topology": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "kind", "pose_xyz", "floor_id"], "properties": {"node_id": {"type": "string"}, "kind": {"type": "string", "enum": ["waypoint", "doorway", "room_portal", "stair", "elevator", "dock", "goal_candidate"]}, "pose_xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "floor_id": {"type": "string"}, "heading_rad": {"type": "number"}, "clearance_m": {"type": "number"}}}},
        "edges": {"type": "array", "items": {"type": "object", "required": ["edge_id", "from", "to", "structurally_connected", "requires_realtime_clearance_check", "cost"], "properties": {"edge_id": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "structurally_connected": {"type": "boolean"}, "requires_realtime_clearance_check": {"type": "boolean", "const": true}, "cost": {"type": "number"}, "edge_type": {"type": "string", "enum": ["corridor", "door", "stair", "elevator", "room_entry", "unknown"]}, "conditions": {"type": "array", "items": {"type": "string"}}}}}
      }
    },
    "map_artifacts": {
      "type": "object",
      "properties": {
        "sparse_landmarks_uri": {"type": "string"},
        "global_pose_graph_uri": {"type": "string"},
        "static_occupancy_uri": {"type": "string"},
        "local_3d_occupancy_uri": {"type": "string", "description": "Ephemeral only; must include an expiry or TTL in the producer metadata."},
        "semantic_index_uri": {"type": "string"}
      }
    }
  }
}
